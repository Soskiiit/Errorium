# ==============================================================================
# Errorium — Конфигурация переменных окружения (.env.example)
# Скопируйте этот файл в .env и настройте параметры для локальной разработки
# ==============================================================================

# === Общие настройки системы ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Search Engine Indexer (Роль 1) ===
RAW_DATA_PATH=/app/data/raw
INDEX_OUTPUT_PATH=/app/data/index

# === Search Engine Core (Роль 2) ===
SEARCH_GRPC_PORT=50051
INDEX_DIR=/app/data/index

# === Gateway & MCP Service (Роль 3) ===
GATEWAY_PORT=8000
SEARCH_ENGINE_HOST=search_engine_core
SEARCH_ENGINE_PORT=50051

# === Web Frontend (Роль 4) ===
FRONTEND_PORT=3000
GATEWAY_API_URL=http://gateway:8000

# === База данных Gateway (PostgreSQL 18+) ===
POSTGRES_PORT=5432 # Внешний порт на хосте для PostgreSQL (если 5432 занят, укажите, например, 5433)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=errorium
DB_USER=errorium_user
DB_PASSWORD=errorium_password
DB_SSLMODE=disable

# === Объектное хранилище аватарок (Garage / S3) ===
GARAGE_PORT=3900 # Внешний порт API S3 на хосте (если 3900 занят, укажите, например, 3910)
GARAGE_ADMIN_PORT=3903 # Внешний порт Admin API Garage на хосте (если 3903 занят, укажите, например, 3913)
GARAGE_ENDPOINT=garage:3900
GARAGE_DEFAULT_ACCESS_KEY=garageadmin
GARAGE_DEFAULT_SECRET_KEY=garageadminpassword
GARAGE_DEFAULT_BUCKET=errorium-avatars
GARAGE_REGION=garage
GARAGE_USE_SSL=false
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# === Аутентификация, JWT и SSO ===
JWT_SECRET_KEY=change-this-in-production-to-strong-secret-key-64chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth2 / SSO провайдеры (Google / Yandex / GitHub)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Стартовая учетная запись администратора
FIRST_ADMIN_EMAIL=admin@errorium.ru
FIRST_ADMIN_PASSWORD=AdminSecurePassword2026!

# === RAG-пайплайн и LLM Провайдер ===
LLM_PROVIDER=openai # openai | anthropic | local
OPENAI_API_KEY=sk-placeholder-api-key
OPENAI_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
