# ==============================================================================
# Errorium — Конфигурация переменных окружения (.env.example)
# Скопируйте этот файл в .env и настройте параметры для локальной разработки
# ==============================================================================

# === Общие настройки системы ===
# Зарезервировано: текущие сервисы не читают эти переменные
# ENVIRONMENT=development
# LOG_LEVEL=INFO

# === Search Engine Indexer (Роль 1) ===
RAW_DATA_PATH=/app/data/raw
INDEX_OUTPUT_PATH=/app/data/index
# Каталог на хосте с архивом дампа (монтируется в контейнер только на чтение) и имя файла
SO_DUMP_DIR=./data/dump
SO_DUMP_FILE=stackoverflow.com.7z
# Параметры выборки корпуса (make index-sample)
SAMPLE_DENOM=100
SAMPLE_RESIDUE=0
SAMPLE_MIN_SCORE=1
GRAPH_MAX_NEIGHBORS=20
SPIMI_BLOCK_POSTINGS=2000000

# === Search Engine Core (Роль 2) ===
SEARCH_GRPC_PORT=50051
# INDEX_DIR читается ядром напрямую; в Docker compose выставляет его из CORE_INDEX_DIR (см. ниже)
INDEX_DIR=/app/data/index

# === Gateway & MCP Service (Роль 3) ===
GATEWAY_PORT=8000
SEARCH_ENGINE_HOST=search_engine_core
SEARCH_ENGINE_PORT=50051
# Автоматические миграции БД при старте gateway (дефолт true)
# AUTO_MIGRATE=true

# === Web Frontend (Роль 4) ===
FRONTEND_PORT=3000
# Порты продакшн-фронтенда (docker-compose.yml, nginx с SSL)
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
# Только для `make dev` (дев-сервер вне Docker); в Docker nginx сам проксирует /api/ на gateway:8000
GATEWAY_API_URL=http://localhost:8000

# === База данных Gateway (PostgreSQL 18+) ===
POSTGRES_PORT=5432 # Внешний порт на хосте для PostgreSQL (если 5432 занят, укажите, например, 5433)
# Основные credentials: их читает docker-compose для контейнера postgres
# и пробрасывает в gateway как DB_NAME/DB_USER/DB_PASSWORD
POSTGRES_DB=errorium
POSTGRES_USER=errorium_user
POSTGRES_PASSWORD=errorium_password
# DB_* используются только при запуске gateway вне Docker;
# в Docker compose переопределяет их значениями из POSTGRES_*
DB_HOST=postgres
DB_PORT=5432
DB_NAME=errorium
DB_USER=errorium_user
DB_PASSWORD=errorium_password
DB_SSLMODE=disable

# === Объектное хранилище аватарок (Garage / S3) ===
GARAGE_PORT=3900 # Внешний порт API S3 на хосте (если 3900 занят, укажите, например, 3910)
GARAGE_ADMIN_PORT=3903 # Внешний порт Admin API Garage на хосте (если 3903 занят, укажите, например, 3913)
GARAGE_ENDPOINT=garage:3900
GARAGE_DEFAULT_ACCESS_KEY=garageadmin
GARAGE_DEFAULT_SECRET_KEY=garageadminpassword
GARAGE_DEFAULT_BUCKET=errorium-avatars
GARAGE_REGION=garage
GARAGE_USE_SSL=false
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# === Аутентификация, JWT и SSO ===
JWT_SECRET_KEY=change-this-in-production-to-strong-secret-key-64chars-min
# JWT_ALGORITHM не читается: gateway всегда подписывает HS256 (pkg/jwt)
# JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth2 / SSO провайдеры (Google / Yandex / GitHub)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# База redirect_uri: {SSO_REDIRECT_BASE}/api/v1/auth/sso/callback/{provider}
# На проде обязательно https://errorium.ru — должно совпадать с настройками OAuth-приложения
SSO_REDIRECT_BASE=http://localhost:8000

# Стартовая учетная запись администратора
FIRST_ADMIN_EMAIL=admin@errorium.ru
FIRST_ADMIN_PASSWORD=AdminSecurePassword2026!

# === RAG-пайплайн и LLM Провайдер (ADR-011) ===
LLM_PROVIDER=stub # openai | gigachat | stub (дефолт БД rag_config; env — начальный)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
RAG_SYSTEM_PROMPT=Ты Errorium — ассистент по диагностике программных ошибок. Отвечай на русском: суть и первопричина, готовый исправленный код, профилактика. Опирайся только на переданные источники Stack Overflow.

# OpenAI-совместимый (OpenAI / прокси / vLLM / Ollama /v1)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-placeholder-api-key
OPENAI_MODEL_NAME=gpt-4o-mini

# GigaChat (бесплатный тариф для физлиц: scope GIGACHAT_API_PERS)
# Client ID / Secret — из личного кабинета developers.sber.ru (GigaChat API)
GIGACHAT_CLIENT_ID=your_gigachat_client_id
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat
# Корневой сертификат НУЦ Минцифры (russian_trusted_root_ca.crt), обязателен для TLS.
# Путь внутри контейнера gateway: compose монтирует ./deploy/certs -> /app/certs (read-only).
# Скачивание сертификата: docs/Tech/02-running.md, п. 5.3
GIGACHAT_CA_CERT=/app/certs/russian_trusted_root_ca.crt

# === Почта (сброс пароля) ===
# SMTP_HOST пуст → dev-режим: ссылка сброса пишется в лог gateway (не для прода)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@errorium.ru

# === Фронтенд и SSO-редиректы ===
FRONTEND_URL=http://localhost:3000
# На проде: https://errorium.ru (редиректы SSO и ссылки сброса пароля)

# === Лимиты MCP и LLM (ADR-012, in-memory) ===
MCP_MAX_SESSIONS_PER_IP=100
MCP_MAX_SESSIONS=200
MCP_CALLS_PER_MIN=60
LLM_MAX_CONCURRENT=8

# === Поисковое ядро (gRPC) ===
SEARCH_ENGINE_ADDR=search_engine_core:50051
# CORE_INDEX_DIR — какой индекс читает ядро в Docker (compose выставляет из него INDEX_DIR)
CORE_INDEX_DIR=/app/data/index
# CORE_INDEX_DIR=/app/data/index-benchmark # вариант для демо на малом корпусе (без полного дампа)
BM25_K1=1.5 # допустимо [1.2, 2.0] по методичке ИУ5
BM25_B=0.75